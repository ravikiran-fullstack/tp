
# ============================================================
# Windows 11 25H2 - Pre-Upgrade Disk Cleanup
# Intune Remediation Script
#
# Minimum Required Free Space : 40 GB
# Execution Account          : SYSTEM
# PowerShell Architecture    : 64-bit
#
# Actions:
# 1. Check available disk space
# 2. Skip cleanup if free space is 40 GB or more
# 3. Check for active Windows Setup / servicing
# 4. Delete all accessible Windows Temp files
# 5. Delete all accessible User Temp files
# 6. Clear Delivery Optimization cache if required
# 7. Record disk space before and after cleanup
# 8. Recommend DISM assessment if still below 40 GB
#
# No reboot or DISM cleanup is performed.
# ============================================================

# ----------------------------
# Configuration
# ----------------------------

$TargetFreeGB = 40

$PolicyVersion = 'TempAll-DO-40GB-v1'

$ReportFolder = Join-Path $env:ProgramData 'Win11TempCleanup'

$ReportFile = Join-Path $ReportFolder 'LastRun.json'


# ----------------------------
# Function: Get Free Disk Space
# ----------------------------

function Get-FreeGB {

    $disk = Get-CimInstance `
        -ClassName Win32_LogicalDisk `
        -Filter "DeviceID='$($env:SystemDrive)'" `
        -ErrorAction Stop

    if (-not $disk) {
        throw "Unable to read system drive."
    }

    return [math]::Round(
        [double]$disk.FreeSpace / 1GB, 2
    )
}


# ----------------------------
# Function: Check Servicing Activity
# ----------------------------

function Get-ServicingBlocker {

    $processNames = @(
        'SetupHost'
        'SetupPrep'
        'WindowsUpdateBox'
        'SetupPlatform'
        'TiWorker'
        'TrustedInstaller'
        'MoUsoCoreWorker'
        'Dism'
    )

    $runningProcesses = @(
        Get-Process `
            -Name $processNames `
            -ErrorAction SilentlyContinue
    )

    if ($runningProcesses.Count -gt 0) {

        $names = (
            $runningProcesses.ProcessName |
            Sort-Object -Unique
        ) -join ','

        return "ActiveProcess:$names"
    }

    $rebootKeys = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending'
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired'
    )

    foreach ($key in $rebootKeys) {

        if (Test-Path -LiteralPath $key) {
            return 'PendingWindowsServicingReboot'
        }
    }

    $pendingFile = Join-Path $env:windir 'WinSxS\pending.xml'

    if (Test-Path -LiteralPath $pendingFile) {
        return 'ComponentServicingPending'
    }

    return $null
}


# ----------------------------
# Step 1: Check Available Space
# ----------------------------

try {

    $BeforeGB = Get-FreeGB

}
catch {

    Write-Output "Status=Error; Reason=CannotReadDiskSpace"

    exit 1
}

Write-Output "Free Space Before Cleanup: $BeforeGB GB"


# ----------------------------
# Step 2: Check 40 GB Threshold
# ----------------------------

if ($BeforeGB -ge $TargetFreeGB) {

    Write-Output "Status=NoCleanupNeeded"
    Write-Output "AvailableSpace=$BeforeGB GB"
    Write-Output "RequiredSpace=$TargetFreeGB GB"

    exit 0
}


# ----------------------------
# Step 3: Check Windows Servicing
# ----------------------------

$blocker = Get-ServicingBlocker

if ($blocker) {

    Write-Output "Status=Skipped"
    Write-Output "Reason=$blocker"

    exit 1
}


# ----------------------------
# Step 4: Identify Temp Locations
# ----------------------------

try {

    $profiles = @(
        Get-CimInstance `
            -ClassName Win32_UserProfile `
            -ErrorAction Stop |
        Where-Object {
            -not $_.Special -and $_.LocalPath
        }
    )

}
catch {

    Write-Output "Status=Error; Reason=CannotReadUserProfiles"

    exit 1
}

$TempFolders = @(
    (Join-Path $env:windir 'Temp')
    (Join-Path $env:windir 'SystemTemp')
    $env:TEMP
)

foreach ($profile in $profiles) {

    $TempFolders += Join-Path `
        $profile.LocalPath `
        'AppData\Local\Temp'
}

# Remove duplicate paths and exclude reparse-point roots.

$OSRoot = [System.IO.Path]::GetPathRoot($env:windir)

$TempFolders = @(
    $TempFolders |
    Where-Object {
        $_ -and (Test-Path -LiteralPath $_ -PathType Container)
    } |
    Sort-Object -Unique |
    Where-Object {

        $item = Get-Item `
            -LiteralPath $_ `
            -Force `
            -ErrorAction SilentlyContinue

        $item -and
        ([System.IO.Path]::GetPathRoot($_) -ieq $OSRoot) -and
        -not ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint)
    }
)


# ----------------------------
# Step 5: Initialize Counters
# ----------------------------

$DeletedFiles = 0
$SkippedFiles = 0
$SkippedLinks = 0
$SkippedFolders = 0

$TempBeforeGB = Get-FreeGB


# ----------------------------
# Step 6: Clean All Temp Files
# ----------------------------

foreach ($root in $TempFolders) {

    $stack = New-Object 'System.Collections.Generic.Stack[string]'

    $stack.Push($root)

    while ($stack.Count -gt 0) {

        $folder = $stack.Pop()

        try {

            $items = @(
                Get-ChildItem `
                    -LiteralPath $folder `
                    -Force `
                    -ErrorAction Stop
            )

        }
        catch {

            $SkippedFolders++
            continue
        }

        foreach ($item in $items) {

            # Skip junctions and symbolic links

            if ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) {

                $SkippedLinks++
                continue
            }

            # Scan subfolders

            if ($item.PSIsContainer) {

                $stack.Push($item.FullName)
                continue
            }

            # Delete all accessible files regardless of age

            try {

                Remove-Item `
                    -LiteralPath $item.FullName `
                    -Force `
                    -ErrorAction Stop

                $DeletedFiles++

            }
            catch {

                # Skip locked or access-denied files

                $SkippedFiles++
            }
        }
    }
}


# ----------------------------
# Step 7: Calculate Temp Recovery
# ----------------------------

$TempAfterGB = Get-FreeGB

$TempFreedGB = [math]::Round(
    ($TempAfterGB - $TempBeforeGB), 2
)

Write-Output "Temp Files Deleted: $DeletedFiles"
Write-Output "Temp Files Skipped: $SkippedFiles"
Write-Output "Space Recovered From Temp: $TempFreedGB GB"


# ----------------------------
# Step 8: Delivery Optimization Cleanup
# ----------------------------

$DOBeforeGB = $TempAfterGB

$DOStatus = 'NotRequired'

if ($DOBeforeGB -lt $TargetFreeGB) {

    $blocker = Get-ServicingBlocker

    if ($blocker) {

        $DOStatus = 'SkippedServicingBusy'

    }
    else {

        try {

            Import-Module DeliveryOptimization -ErrorAction Stop

            # Verify the supported cmdlets are available.

            Get-Command `
                -Name Delete-DeliveryOptimizationCache `
                -ErrorAction Stop | Out-Null

            $transfers = @(
                Get-DeliveryOptimizationStatus -ErrorAction Stop
            )

            $activeTransfers = @(
                $transfers |
                Where-Object {
                    [string]$_.Status -match '^(Downloading|Uploading|Transferring|Caching)$'
                }
            )

            if ($activeTransfers.Count -gt 0) {

                $DOStatus = 'SkippedActiveTransfers'

            }
            else {

                # Preserve pinned Delivery Optimization content.

                Delete-DeliveryOptimizationCache `
                    -Force `
                    -ErrorAction Stop | Out-Null

                $DOStatus = 'Cleared'
            }

        }
        catch {

            $DOStatus = 'FailedOrUnavailable'
        }
    }
}


# ----------------------------
# Step 9: Calculate Final Free Space
# ----------------------------

$AfterGB = Get-FreeGB

$DOFreedGB = [math]::Round(
    ($AfterGB - $DOBeforeGB), 2
)

$TotalFreedGB = [math]::Round(
    ($AfterGB - $BeforeGB), 2
)

$Meets40GB = $AfterGB -ge $TargetFreeGB


# ----------------------------
# Step 10: Determine Next Action
# ----------------------------

if ($Meets40GB) {

    $NextAction = 'ReadyForSpaceCheck'

}
else {

    $NextAction = 'AssessDISMSeparately'
}


# ----------------------------
# Step 11: Save Cleanup Report
# ----------------------------

$Result = [ordered]@{

    PolicyVersion    = $PolicyVersion

    Completed        = $true

    Timestamp        = (Get-Date).ToString('s')

    ComputerName     = $env:COMPUTERNAME

    TargetFreeGB     = $TargetFreeGB

    BeforeGB         = $BeforeGB

    TempAfterGB      = $TempAfterGB

    AfterGB          = $AfterGB

    TempFreedGB      = $TempFreedGB

    DOFreedGB        = $DOFreedGB

    TotalFreedGB     = $TotalFreedGB

    TempFilesDeleted = $DeletedFiles

    TempFilesSkipped = $SkippedFiles

    LinksSkipped     = $SkippedLinks

    FoldersSkipped   = $SkippedFolders

    DOStatus         = $DOStatus

    Meets40GB        = $Meets40GB

    NextAction       = $NextAction
}

try {

    New-Item `
        -Path $ReportFolder `
        -ItemType Directory `
        -Force `
        -ErrorAction Stop | Out-Null

    $Result |
        ConvertTo-Json -Depth 3 |
        Set-Content `
            -LiteralPath $ReportFile `
            -Encoding UTF8 `
            -ErrorAction Stop

}
catch {

    Write-Output "Status=Error; Reason=ReportWriteFailed"

    exit 1
}


# ----------------------------
# Step 12: Output Results to Intune
# ----------------------------

Write-Output "========== CLEANUP SUMMARY =========="

Write-Output "Status=Completed"

Write-Output "BeforeGB=$BeforeGB"

Write-Output "AfterGB=$AfterGB"

Write-Output "TempFreedGB=$TempFreedGB"

Write-Output "DOFreedGB=$DOFreedGB"

Write-Output "TotalFreedGB=$TotalFreedGB"

Write-Output "DeletedFiles=$DeletedFiles"

Write-Output "SkippedFiles=$SkippedFiles"

Write-Output "DOStatus=$DOStatus"

Write-Output "Meets40GB=$Meets40GB"

Write-Output "NextAction=$NextAction"

Write-Output "====================================="

exit 0
